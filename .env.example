# ========================================================
# 后端服务配置 (Java emb-server)
# ========================================================

# 1. 后端目标服务地址 (服务端配置，由 Next.js rewrites 反向代理，彻底免跨域)
# 本地开发默认为 http://localhost:8080，生产部署可配置为容器名或内网服务地址 (如 http://emb-server:8080)
BACKEND_URL=http://localhost:8080

# 2. 客户端请求的 API 基础路径 (公开给浏览器)
# 默认使用同源相对路径 "/api"，由 Next.js 代理转发至 BACKEND_URL/v1/*
# 若通过独立 API 网关或直连，可修改为对应网关地址
NEXT_PUBLIC_API_BASE_URL=/api
